# LLM (OpenAI-compatible API)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embedding (local model, downloaded to backend/models/)
EMBEDDING_MODEL=BAAI/bge-m3

# Tavily Search
TAVILY_API_KEY=

# PostgreSQL
DATABASE_URL=postgresql://knowledge_agent:knowledge_agent@localhost:7432/knowledge_agent

# LangSmith (optional, for tracing & observability)
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=knowledge-agent

# Cross-encoder re-ranking (local model, downloaded to backend/models/)
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=true

# Debug server URL (optional, for development diagnostics)
# DEBUG_SERVER_URL=http://127.0.0.1:7777/event
